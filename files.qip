set_global_assignment -name SYSTEMVERILOG_FILE rtl/namco6809_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/superpac_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/boards/superpac_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/namco_15xx.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/namco/namco_io.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/art/artwork.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/art/art_resample.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/art/png_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/art/inflate.sv

set_global_assignment -name VERILOG_FILE rtl/cpu/MC6809/mc6809is.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/mb88_sv/mb88_core.sv
