set_global_assignment -name VERILOG_FILE rtl/cpu/jt680x/jtframe_6801mcu.v
set_global_assignment -name VERILOG_FILE rtl/cpu/jt680x/jtframe_ram.v
set_global_assignment -name VERILOG_FILE rtl/sound/jtcus30/jtcus30_mmr.v
