<misterromdescription>
    <name>Pac & Pal</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pac-Man</series>
    <year>1983</year>
    <manufacturer>Namco</manufacturer>
    <category>Maze</category>

    <setname>pacnpal</setname>
    <parent>pacnpal</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Button 1,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,77,FF">
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Service Mode" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Coin A" bits="8,10" ids="3C/1C,2C/1C,1C/1C,2C/3C,1C/2C,1C/3C,1C/6C,1C/7C" values="0,2,7,1,6,5,4,3"/>
        <dip name="Bonus Life" bits="11,13" ids="20k & 70k Only,20k; 70k & Every 70k,30k Only,30k & 70k Only,30k & 80k Only,30k; 80k & Every 80k,30k & 100k Only,None" values="4,6,0,3,2,5,1,7"/>
        <dip name="Lives" bits="14,15" ids="1,2,3,5" values="3,2,1,0"/>
        <dip name="Coin B" bits="16,17" ids="2C/1C,1C/1C,2C/3C,1C/2C" values="1,3,0,2"/>
        <dip name="Difficulty" bits="18,19" ids="Rank A,Rank B,Rank C,Rank D" values="3,2,1,0"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="pacnpal.zip">
        <part crc="ed64a565" name="pap1-3b.1d"/>
        <part crc="15308bcf" name="pap1-2b.1c"/>
        <part crc="3cac401c" name="pap3-1.1b"/>
        <part crc="330e20de" name="pap1-4.1k"/>
        <part crc="a36b96cb" name="pap1-6.3c"/>
        <part crc="fb6f56e3" name="pap1-5.3f"/>
        <part repeat="0xE000">00</part>
        <part crc="52634b41" name="pap1-6.4c"/>
        <part crc="ac46203c" name="pap1-5.4e"/>
        <part crc="686bde84" name="pap1-4.3l"/>
        <part repeat="0x5E0">00</part>
        <part crc="94782db5" name="pap1-3.3m"/>
    </rom>

