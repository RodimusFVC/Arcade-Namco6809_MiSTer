<misterromdescription>
    <name>Mappy</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Mappy</series>
    <year>1983</year>
    <manufacturer>Namco</manufacturer>
    <category>Platform</category>

    <setname>mappy</setname>
    <parent>mappy</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Door,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF">
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Service Mode" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="8,10" ids="Rank A,Rank B,Rank C,Rank D,Rank E,Rank F,Rank G,Rank H" values="7,6,5,4,3,2,1,0"/>
        <dip name="Coin B" bits="11,12" ids="2C/1C,1C/1C,1C/5C,1C/7C" values="0,3,2,1"/>
        <dip name="Demo Sounds" bits="13" ids="Off,On"/>
        <dip name="Rack Test (Cheat)" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Freeze" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Coin A" bits="16,18" ids="3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/6C" values="1,3,0,7,2,6,5,4"/>
        <dip name="Bonus Life" bits="19,21" ids="20k Only,20k & 60k Only,20k & 70k Only,20k; 70k & Every 70k,20k & 80k Only,20k; 80k & Every 80k,30k & 100k Only,None" values="3,6,7,2,5,1,4,0"/>
        <dip name="Lives" bits="22,23" ids="1,2,3,5" values="1,0,3,2"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="mappy.zip">
        <part crc="52e6c708" name="mpx_3.1d"/>
        <part crc="a958a61c" name="mp1_2.1c"/>
        <part crc="203766d4" name="mpx_1.1b"/>
        <part crc="8182dd5b" name="mp1_4.1k"/>
        <part crc="16498b9f" name="mp1_5.3b"/>
        <part crc="f2d9647a" name="mp1_6.3m"/>
        <part crc="757cf2b6" name="mp1_7.3n"/>
        <part repeat="0xB000">00</part>
        <part crc="56531268" name="mp1-5.5b"/>
        <part crc="50765082" name="mp1-6.4c"/>
        <part crc="5396bd78" name="mp1-7.5k"/>
        <part repeat="0x5E0">00</part>
        <part crc="16a9166a" name="mp1-3.3m"/>
    </rom>

    <!-- Index 1: board variant, flags, I/O kinds, control idle levels, input map, ROM offsets (see Arcade-Namco6809.sv) -->
    <rom index="1">
        <part>
            02 90 05 00 FF FF FF FF 00 00 00 00 00 00 00 00
            11 12 00 16 00 00 00 00 00 04 00 03 00 00 00 00
            00 0C 00 0B 00 00 00 00 05 0D 13 14 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 24 00
            00 00 00 00 00 00 00 00 60 01 80 01 00 00 80 00
            90 00
        </part>
    </rom>

