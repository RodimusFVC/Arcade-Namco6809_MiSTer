<misterromdescription>
    <name>Dragon Buster</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Dragon Buster</series>
    <year>1984</year>
    <manufacturer>Namco</manufacturer>
    <category>Platform</category>

    <setname>drgnbstr</setname>
    <parent>drgnbstr</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Button 1,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF">
        <dip name="Coin B" bits="0,1" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Freeze" bits="2" ids="Off,On" values="1,0"/>
        <dip name="Round Skip" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Demo Sounds" bits="4" ids="Off,On"/>
        <dip name="Coin A" bits="5,6" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Service Mode" bits="7" ids="Off,On" values="1,0"/>
        <dip name="Allow Continue" bits="8" ids="No,Yes"/>
        <dip name="Bonus Level" bits="9" ids="Partial,Full"/>
        <dip name="Bonus Vitality" bits="10,11" ids="32/64,48/64,64,None" values="1,2,0,3"/>
        <dip name="Starting Vitality" bits="12,13" ids="64,96,128,160" values="2,1,3,0"/>
        <dip name="Level of Monster" bits="14" ids="Normal,Difficult" values="1,0"/>
        <dip name="Spurt Time" bits="15" ids="Normal,Difficult" values="1,0"/>
        <dip name="Cabinet" bits="17" ids="Upright,Cocktail" values="1,0"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="drgnbstr.zip">
        <part crc="0f11cd17" name="db1_2b.6c"/>
        <part crc="1c7c1821" name="db1_1.6b"/>
