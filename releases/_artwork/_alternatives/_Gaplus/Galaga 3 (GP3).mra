<misterromdescription>
    <name>Galaga 3 (GP3)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxian</series>
    <year>1984</year>
    <manufacturer>Namco</manufacturer>
    <category>Shooter</category>

    <setname>galaga3b</setname>
    <parent>gaplus</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF">
        <dip name="Coin B" bits="0,1" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Lives" bits="6,7" ids="2,3,4,5" values="2,3,1,0"/>
        <dip name="Round Advance" bits="11" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="8,10" ids="30k 70k and every 70k,30k 100k and every 100k,30k 100k and every 200k,50k 100k and every 100k,50k 100k and every 200k,50k 150k and every 150k,50k 150k and every 300k,50k 150k" values="0,1,2,3,4,7,5,6"/>
        <dip name="Unknown" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="12,14" ids="0 - Standard,1 - Easiest,2,3,4,5,6,7 - Hardest" values="7,6,5,4,3,2,1,0"/>
        <dip name="Cabinet" bits="18" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Service Mode" bits="19" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="galaga3b.zip|gaplus.zip|namco62.zip">
        <part crc="58de387c" name="gp3-4.8d"/>
        <part crc="94a3fd4e" name="gp3-3.8c"/>
