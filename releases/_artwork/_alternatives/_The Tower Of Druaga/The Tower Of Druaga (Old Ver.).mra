<misterromdescription>
    <name>The Tower Of Druaga (Old Ver.)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Babylonian Castle Saga</series>
