    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Sword,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF">
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Lives" bits="8,9" ids="1,2,3,5" values="1,2,3,0"/>
        <dip name="Coin A" bits="10,11" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,2,3,1"/>
        <dip name="Freeze" bits="12" ids="Off,On" values="1,0"/>
        <dip name="Service Mode" bits="13" ids="Off,On" values="1,0"/>
        <dip name="Coin B" bits="14,15" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,2,3,1"/>
    </switches>

