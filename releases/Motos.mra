<misterromdescription>
    <name>Motos</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Motos</series>
    <year>1985</year>
    <manufacturer>Namco</manufacturer>
    <category>Action</category>

    <setname>motos</setname>
    <parent>motos</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Jump,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF">
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Service Mode" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="9,10" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Lives" bits="11" ids="3,5" values="1,0"/>
        <dip name="Difficulty" bits="12" ids="Rank A,Rank B" values="1,0"/>
        <dip name="Bonus Life" bits="13,14" ids="10k 30k and every 50k,20k and every 50k,30k and every 70k,20k 70k" values="3,2,1,0"/>
        <dip name="Demo Sounds" bits="15" ids="Off,On"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="motos.zip">
        <part crc="1104abb2" name="mo1_3.1d"/>
        <part crc="57b157e2" name="mo1_1.1b"/>
        <part crc="55e45d21" name="mo1_4.1k"/>
        <part crc="5d4a2a22" name="mo1_5.3b"/>
        <part crc="2f0e396e" name="mo1_6.3m"/>
        <part crc="cf8a3b86" name="mo1_7.3n"/>
        <part repeat="0x5000">00</part>
        <part crc="71972383" name="mo1-5.5b"/>
        <part crc="730ba7fb" name="mo1-6.4c"/>
        <part crc="7721275d" name="mo1-7.5k"/>
        <part repeat="0x5E0">00</part>
        <part crc="2accdfb4" name="mo1-3.3m"/>
    </rom>

    <!-- Index 1: board variant, flags, I/O kinds, control idle levels, input map, ROM offsets (see Arcade-Namco6809.sv) -->
    <rom index="1">
        <part>
            02 90 00 02 FF FF FF FF 00 00 00 00 00 00 00 00
            11 12 00 16 00 00 00 00 01 04 02 03 00 00 00 00
            09 0C 0A 0B 00 00 00 00 05 0D 13 14 00 00 00 00
            06 0E 00 16 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 80 01 A0 01 00 00 A0 00
            B0 00
        </part>
    </rom>

    <remark>Motos (Namco)</remark>
    <mratimestamp>20261024000000</mratimestamp>
</misterromdescription>
