<misterromdescription>
    <name>The Tower Of Druaga</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Babylonian Castle Saga</series>
    <year>1984</year>
    <manufacturer>Namco</manufacturer>
    <category>Maze</category>

    <setname>todruaga</setname>
    <parent>todruaga</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Sword,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF">
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Lives" bits="8,9" ids="1,2,3,5" values="1,2,3,0"/>
        <dip name="Coin A" bits="10,11" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,2,3,1"/>
        <dip name="Freeze" bits="12" ids="Off,On" values="1,0"/>
        <dip name="Service Mode" bits="13" ids="Off,On" values="1,0"/>
        <dip name="Coin B" bits="14,15" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,2,3,1"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="todruaga.zip">
        <part crc="fbf16299" name="td2_3.1d"/>
        <part crc="b238d723" name="td2_1.1b"/>
        <part crc="ae9d06d9" name="td1_4.1k"/>
        <part crc="d32b249f" name="td1_5.3b"/>
        <part crc="e827e787" name="td1_6.3m"/>
        <part crc="962bd060" name="td1_7.3n"/>
        <part repeat="0x9000">00</part>
        <part crc="122cc395" name="td1-5.5b"/>
        <part crc="8c661d6a" name="td1-6.4c"/>
        <part crc="a86c74dd" name="td1-7.5k"/>
        <part repeat="0x2E0">00</part>
        <part crc="07104c40" name="td1-3.3m"/>
    </rom>

    <!-- Index 1: board variant, flags, I/O kinds, control idle levels, input map, ROM offsets (see Arcade-Namco6809.sv) -->
    <rom index="1">
        <part>
            02 91 01 05 FF FF FF FF 00 00 00 00 00 00 00 00
            11 12 00 16 00 00 00 00 01 04 02 03 00 00 00 00
            09 0C 0A 0B 00 00 00 00 05 0D 13 14 00 00 00 00
            00 00 00 16 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 80 01 A0 01 00 00 A0 00
            B0 00 00 01 02 03 04 05 06 07 00 01 02 03 04 05
            06 07 00 01 02 03 04 05 06 07
        </part>
    </rom>

    <remark>The Tower Of Druaga (New Ver.) (Namco)</remark>
    <mratimestamp>20261024000000</mratimestamp>
</misterromdescription>
