<misterromdescription>
    <name>Grobda (Old Ver. Set 2)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Grobda</series>
    <year>1984</year>
    <manufacturer>Namco</manufacturer>
    <category>Shooter</category>

    <setname>grobda3</setname>
    <parent>grobda</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Button 1,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,C9,FF">
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Service Mode" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Coin A" bits="9,11" ids="4C/1C,3C/1C,2C/1C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C" values="0,1,3,4,2,5,7,6"/>
        <dip name="Coin B" bits="12,14" ids="4C/1C,3C/1C,2C/1C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C" values="0,1,3,4,2,5,7,6"/>
        <dip name="Freeze" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="16,17" ids="1,2,3,5" values="2,1,3,0"/>
        <dip name="Difficulty" bits="18,19" ids="Rank A,Rank B,Rank C,Rank D" values="3,2,1,0"/>
        <dip name="Demo Sounds" bits="20" ids="Off,On"/>
        <dip name="Level Select" bits="21" ids="Off,On"/>
        <dip name="Bonus Life" bits="22,23" ids="10k; 50k & Every 50k,10k & 30k Only,10k Only,None" values="0,1,3,2"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="grobda3.zip|grobda.zip">
        <part crc="4ef4a7c1" name="gr1-3.1d"/>
        <part crc="7dcc6e8e" name="gr1-2.1c"/>
        <part crc="32d42f22" name="gr1-1.1b"/>
        <part crc="3fe78c08" name="gr1-4.1k"/>
        <part crc="4ebfabfd" name="gr1-7.3c"/>
        <part crc="eed43487" name="gr1-5.3f"/>
        <part crc="cebb7362" name="gr1-6.3e"/>
        <part repeat="0xB000">00</part>
        <part crc="c65efa77" name="gr1-6.4c"/>
        <part crc="a0f66911" name="gr1-5.4e"/>
        <part crc="f1f2c234" name="gr1-4.3l"/>
        <part repeat="0x5E0">00</part>
        <part crc="66eb1467" name="gr1-3.3m"/>
    </rom>

    <!-- Index 1: board variant, flags, I/O kinds, control idle levels, input map, ROM offsets (see Arcade-Namco6809.sv) -->
    <rom index="1">
        <part>
            00 90 01 02 FF FF FF FF 00 00 00 00 00 00 00 00
            11 12 00 16 00 00 00 00 01 04 02 03 00 00 00 00
            09 0C 0A 0B 00 00 00 00 05 0D 13 14 00 00 00 00
            06 0E 00 16 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 60 01 80 01 00 00 80 00
            90 00 00 01 02 03 04 05 06 07 00 01 02 03 04 05
            06 07 00 01 02 03 04 05 06 07
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            11 D6 14 05 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 1B 00 00 A0 20 00
            00 00 09 51 00 04 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="164"></nvram>

    <remark>Grobda (Old Ver. Set 2) (Namco)</remark>
    <mratimestamp>20261024000000</mratimestamp>
</misterromdescription>
