<misterromdescription>
    <name>Sky Kid (Old Version)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Sky Kid</series>
    <year>1985</year>
    <manufacturer>Namco</manufacturer>
    <category>Shooter</category>

    <setname>skykido</setname>
    <parent>skykid</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Loop,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF">
        <dip name="Coin B" bits="0,1" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Freeze" bits="2" ids="Off,On" values="1,0"/>
        <dip name="Round Skip" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Demo Sounds" bits="4" ids="Off,On"/>
        <dip name="Coin A" bits="5,6" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Service Mode" bits="7" ids="Off,On" values="1,0"/>
        <dip name="Flip Screen" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Allow Buy In" bits="9" ids="No,Yes"/>
        <dip name="Bonus Life" bits="12,13" ids="20k every 80k,20k and 80k,30k every 90k,30k and 90k"/>
        <dip name="Lives" bits="14,15" ids="1,2,3,5" values="2,1,3,0"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="skykido.zip|skykid.zip">
        <part crc="ea8a5822" name="sk2_2.6c"/>
        <part crc="070a49d4" name="sk1_1.6b"/>
        <part crc="314b8765" name="sk1_3.6d"/>
        <part crc="58b731b9" name="sk1_6.6l"/>
        <part crc="c33a498e" name="sk1_5.7e"/>
        <part crc="44bb7375" name="sk1_8.10n"/>
        <part crc="3454671d" name="sk1_7.10m"/>
        <part crc="0218e726" name="sk1-1.2n"/>
        <part crc="fc0d5b85" name="sk1-2.2p"/>
        <part crc="d06b620b" name="sk1-3.2r"/>
        <part crc="c697ac72" name="sk1-4.5n"/>
        <part crc="161514a4" name="sk1-5.6n"/>
        <part repeat="0x900">00</part>
        <part crc="a460d0e0" name="sk2_4.3c"/>
        <part repeat="0x1000">00</part>
        <part crc="6ef08fb3" name="cus63-63a1.mcu"/>
    </rom>

    <!-- Index 1: board variant, flags, I/O kinds, control idle levels, input map, ROM offsets (see Arcade-Namco6809.sv) -->
    <rom index="1">
        <part>
            04 08 00 06 FF FF FF FF 00 00 00 00 00 00 00 00
            16 11 12 13 14 00 00 00 03 04 02 01 05 00 00 00
            0B 0C 0A 09 0D 00 00 00 00 00 0E 06 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 80 01 C0 00 00 00 E0 00
            00 01 00 01 02 03 04 05 06 07 00 01 02 03 04 05
            06 07 00 01 02 03 04 05 06 07
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            06 17 26 0E 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 50 00 00 45 00 0A
            00 00 50 01 00 01 03 03
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="70"></nvram>

    <remark>Sky Kid (Old Version) (Namco)</remark>
    <mratimestamp>20261024000000</mratimestamp>
</misterromdescription>
