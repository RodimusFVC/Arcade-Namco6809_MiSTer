<misterromdescription>
    <name>Galaga 3 (Set 5)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxian</series>
    <year>1984</year>
    <manufacturer>Namco</manufacturer>
    <category>Shooter</category>

    <setname>galaga3m</setname>
    <parent>gaplus</parent>
    <mameversion>0289</mameversion>
    <rbf>Namco6809</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,F8,FF">
        <dip name="Coin B" bits="0,1" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,1,3,2"/>
        <dip name="Lives" bits="6,7" ids="2,3,4,5" values="2,3,1,0"/>
        <dip name="Round Advance" bits="11" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="8,10" ids="30k 150k and every 600k,50k 150k and every 300k,50k 150k and every 600k,50k 200k and every 300k,100k 300k and every 300k,100k 300k and every 600k,150k 400k and every 900k,150k 400k" values="0,1,2,3,4,7,5,6"/>
        <dip name="Unknown" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="12,14" ids="0 - Standard,1 - Easiest,2,3,4,5,6,7 - Hardest" values="7,6,5,4,3,2,1,0"/>
        <dip name="Cabinet" bits="18" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Service Mode" bits="19" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: packed CPU / tile / sprite store 0x00000 (offsets in index 1), PROMs 0x18000, waveform 0x18800, 62XX 0x19000 -->
    <rom index="0" md5="none" zip="galaga3m.zip|gaplus.zip|namco62.zip">
        <part crc="e392704e" name="m1.9e"/>
        <part crc="86fac687" name="m2.9d"/>
        <part crc="f1b00073" name="m3.9c"/>
        <part crc="9ec3dce5" name="m6.6l"/>
        <part crc="0621f7df" name="m5.6m"/>
        <part crc="6a2942c5" name="m4.6n"/>
        <part crc="ed8aa206" name="gp2-1.7b"/>
        <part crc="8d4dcebf" name="gal3_9l.bin"/>
        <part crc="57740ff9" name="gp2-11.5m"/>
        <part crc="6cd8ce11" name="gp2-10.5l"/>
        <part crc="7316a1f1" name="gp2-12.5k"/>
        <part crc="e6a9ae67" name="gp2-9.5n"/>
        <part crc="a5091352" name="gp2-3.1c"/>
        <part crc="8bc8022a" name="gp2-1.1d"/>
        <part crc="8dabc20b" name="gp2-2.2d"/>
        <part crc="2faa3e09" name="gp2-7.4f"/>
        <part crc="d48c0eef" name="g3_3f.3f"/>
        <part crc="417ba0dc" name="g3_3e.3e"/>
        <part crc="2d9fbdd8" name="gp2-4.3f"/>
        <part repeat="0x700">00</part>
        <part crc="308dc115" name="62xx.bin"/>
    </rom>

    <!-- Index 1: board variant, flags, I/O kinds, control idle levels, input map, ROM offsets (see Arcade-Namco6809.sv) -->
    <rom index="1">
        <part>
            03 90 04 07 FF FF FF FF 00 00 00 00 00 00 00 00
            11 12 00 16 00 00 00 00 01 04 02 03 00 00 00 00
            09 0C 0A 0B 00 00 00 00 05 0D 13 14 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 60 01 C0 01 E0 01 E0 00
            00 01 00 01 02 03 04 05 06 07 00 01 02 03 04 05
            06 07 00 01 02 03 04 05 06 07
